{
  "name": "gyral-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm invariants && pnpm test",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"packages/*/src/**/*.ts\" \"examples/*/src/**/*.ts\" \"examples/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "invariants": "node scripts/check-docs.mjs && node scripts/check-workflows.mjs && node scripts/check-public-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:local": "node scripts/ci-local.mjs",
    "examples": "node scripts/examples.mjs",
    "size": "node scripts/measure-bundles.mjs",
    "ui:check": "node scripts/ui-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gyral/devtools": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-compat": "7.0.2",
    "globals": "17.13.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "postcss-lit": "1.4.1",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-plugin-use-baseline": "1.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "valibot": "1.5.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
