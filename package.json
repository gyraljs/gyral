{
  "name": "gyral-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm invariants && pnpm test && pnpm size:check && node scripts/check-fixtures.mjs && pnpm pack:check",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && pnpm lint:css",
    "lint:css": "stylelint \"packages/*/src/**/*.ts\" \"examples/*/src/**/*.ts\" \"examples/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "invariants": "node scripts/check-docs.mjs && node scripts/check-workflows.mjs && node scripts/check-public-api.mjs && node scripts/check-skill.mjs && node scripts/check-provenance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:view": "vitest run --config packages/core/bench/vitest.config.ts",
    "ci:local": "node scripts/ci-local.mjs",
    "examples": "node scripts/examples.mjs",
    "size": "node scripts/measure-bundles.mjs",
    "size:check": "node scripts/measure-bundles.mjs --check",
    "ui:check": "node scripts/ui-check.mjs",
    "demos:record": "node scripts/demos-record.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "pack:check": "node scripts/pack-check.mjs",
    "pack:next": "node scripts/pack-next.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:create": "node scripts/verify-create.mjs",
    "mcp:refresh": "pnpm --filter @gyral/mcp run refresh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@gyral/devtools": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.12.0",
    "eslint-plugin-compat": "7.0.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.28",
    "postcss-styled-syntax": "0.7.3",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "stylelint": "17.16.0",
    "stylelint-plugin-use-baseline": "1.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "valibot": "1.5.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  }
}
