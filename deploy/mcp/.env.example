# Set the immutable digest reported by the image publication.
GYRAL_MCP_IMAGE=ghcr.io/gyraljs/gyral-mcp@sha256:REPLACE_WITH_PUBLISHED_IMAGE_DIGEST
GYRAL_MCP_EXPECTED_CORPUS_SHA256=REPLACE_WITH_PUBLISHED_CORPUS_DIGEST
GYRAL_MCP_PUBLIC_ORIGIN=https://mcp.gyral.dev
# Empty is correct for machine coding agents; add exact HTTPS browser origins only if needed.
GYRAL_MCP_ALLOWED_ORIGINS=
GYRAL_MCP_MAX_CONCURRENT=32
GYRAL_MCP_REQUESTS_PER_MINUTE=600
# These must match the names already configured in your Traefik deployment.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
