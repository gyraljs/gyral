{
  "name": "@gyral/core",
  "version": "0.0.0",
  "description": "Gyral core: Model-View-Intent web components on Lit and the web platform. Inspired by Cycle.js.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    },
    "imports": {
      "#devtools": {
        "development": "./dist/devtools.js",
        "default": "./dist/devtools-off.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "effect": "3.22.2"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "lit": "3.3.3"
  },
  "imports": {
    "#devtools": {
      "development": "./src/devtools.ts",
      "default": "./src/devtools-off.ts"
    }
  }
}
