{
  "name": "@gyral/core",
  "version": "0.3.0",
  "description": "Gyral core: Model-View-Intent web components on the web platform, with their own view layer.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./internal": "./src/internal.ts",
    "./vite": "./src/vite.ts",
    "./compiled": "./src/view/compiled.ts",
    "./eslint": "./src/eslint/index.ts"
  },
  "imports": {
    "#devtools": {
      "development": "./src/devtools.ts",
      "default": "./src/devtools-off.ts"
    },
    "#prepare": {
      "gyral-compiled": "./src/view/prepare-stub.ts",
      "default": "./src/view/prepare.ts"
    },
    "#view-dev": {
      "development": "./src/view/dev.ts",
      "default": "./src/view/dev-off.ts"
    },
    "#hydration-loader": {
      "gyral-client-only": "./src/hydration-off.ts",
      "default": "./src/hydration-loader.ts"
    },
    "#invoker-fallback": {
      "gyral-client-only": {
        "development": "./src/invoker-fallback.ts",
        "default": "./src/invoker-fallback-used.ts"
      },
      "default": "./src/invoker-fallback.ts"
    },
    "#spec-features": {
      "gyral-compiled": "./src/spec-features-used.ts",
      "default": "./src/spec-features.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./compiled": {
        "types": "./dist/view/compiled.d.ts",
        "default": "./dist/view/compiled.js"
      },
      "./eslint": {
        "types": "./dist/eslint/index.d.ts",
        "default": "./dist/eslint/index.js"
      }
    },
    "imports": {
      "#devtools": {
        "development": "./dist/devtools.js",
        "default": "./dist/devtools-off.js"
      },
      "#prepare": {
        "gyral-compiled": "./dist/view/prepare-stub.js",
        "default": "./dist/view/prepare.js"
      },
      "#view-dev": {
        "development": "./dist/view/dev.js",
        "default": "./dist/view/dev-off.js"
      },
      "#hydration-loader": {
        "gyral-client-only": "./dist/hydration-off.js",
        "default": "./dist/hydration-loader.js"
      },
      "#invoker-fallback": {
        "gyral-client-only": {
          "development": "./dist/invoker-fallback.js",
          "default": "./dist/invoker-fallback-used.js"
        },
        "default": "./dist/invoker-fallback.js"
      },
      "#spec-features": {
        "gyral-compiled": "./dist/spec-features-used.js",
        "default": "./dist/spec-features.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "parse5": "^7.0.0 || ^8.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "parse5": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "parse5": "8.0.1",
    "vite": "8.3.2"
  }
}
