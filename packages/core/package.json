{
  "name": "@gyral/core",
  "version": "0.1.0",
  "description": "Gyral core: Model-View-Intent web components on Lit and the web platform. Inspired by Cycle.js.",
  "license": "MIT",
  "author": "The Zoop Troop, Inc.",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts"
  },
  "imports": {
    "#devtools": {
      "development": "./src/devtools.ts",
      "default": "./src/devtools-off.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      }
    },
    "imports": {
      "#devtools": {
        "development": "./dist/devtools.js",
        "default": "./dist/devtools-off.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "effect": "3.22.2"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "lit": "3.3.3"
  }
}
