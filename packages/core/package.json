{
  "name": "@gyral/core",
  "version": "0.2.0",
  "description": "Gyral core: Model-View-Intent web components on Lit and the web platform. Inspired by Cycle.js.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./compiled": "./src/view/compiled.ts"
  },
  "imports": {
    "#devtools": {
      "development": "./src/devtools.ts",
      "default": "./src/devtools-off.ts"
    },
    "#prepare": {
      "gyral-compiled": "./src/view/prepare-stub.ts",
      "default": "./src/view/prepare.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./compiled": {
        "types": "./dist/view/compiled.d.ts",
        "default": "./dist/view/compiled.js"
      }
    },
    "imports": {
      "#devtools": {
        "development": "./dist/devtools.js",
        "default": "./dist/devtools-off.js"
      },
      "#prepare": {
        "gyral-compiled": "./dist/view/prepare-stub.js",
        "default": "./dist/view/prepare.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "lit": "^3.3.0",
    "parse5": "^7.0.0 || ^8.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "parse5": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "3.3.3",
    "parse5": "8.0.1",
    "vite": "8.3.2"
  }
}
