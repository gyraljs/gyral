{
  "name": "@gyral/http",
  "version": "0.0.0",
  "description": "Gyral HTTP driver: fetch requests as data, typed errors, Standard Schema decoding.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@gyral/core": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/http"
  },
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/http#readme",
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  }
}
