{
  "name": "@gyral/http",
  "version": "0.3.6",
  "description": "Gyral HTTP driver: fetch requests as data, typed errors, Standard Schema decoding.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/http"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./sse": "./src/sse.ts",
    "./websocket": "./src/websocket.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./sse": {
        "types": "./dist/sse.d.ts",
        "default": "./dist/sse.js"
      },
      "./websocket": {
        "types": "./dist/websocket.d.ts",
        "default": "./dist/websocket.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@gyral/core": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  }
}
