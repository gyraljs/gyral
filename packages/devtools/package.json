{
  "name": "@gyral/devtools",
  "version": "0.1.0",
  "description": "Gyral devtools: an in-page timeline of messages, state, commands and stores (development builds).",
  "license": "MIT",
  "author": "The Zoop Troop, Inc.",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/devtools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/panel.ts",
    "./dist/panel.js"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@gyral/core": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "lit": "3.3.3"
  }
}
