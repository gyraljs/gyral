{
  "name": "@gyral/ssr",
  "version": "0.2.0",
  "description": "Gyral server rendering: Declarative Shadow DOM pages with hydration seeds.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/ssr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/ssr"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/hydrate.ts",
    "./dist/hydrate.js",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./hydrate": "./src/hydrate.ts",
    "./static": "./src/static.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./hydrate": {
        "types": "./dist/hydrate.d.ts",
        "default": "./dist/hydrate.js"
      },
      "./static": {
        "types": "./dist/static.d.ts",
        "default": "./dist/static.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@gyral/core": "workspace:*",
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@gyral/testing": "workspace:*",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "lit": "3.3.3"
  }
}
