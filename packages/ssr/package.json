{
  "name": "@gyral/ssr",
  "version": "0.3.10",
  "description": "Gyral server rendering: Declarative Shadow DOM pages with hydration seeds.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/ssr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/ssr"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js",
    "./src/core.ts",
    "./dist/core.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./static": "./src/static.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./static": {
        "types": "./dist/static.d.ts",
        "default": "./dist/static.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "@gyral/core": "workspace:*",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gyral/core": "workspace:*",
    "@gyral/testing": "workspace:*",
    "@hono/node-server": "2.1.5",
    "esbuild": "0.28.2",
    "hono": "4.13.13",
    "vite": "8.3.4"
  }
}
