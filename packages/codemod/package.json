{
  "name": "@gyral/codemod",
  "version": "0.3.9",
  "description": "Rewrites a Gyral app's source for a release's API changes: npx @gyral/codemod 0.3.8.",
  "keywords": [
    "gyral",
    "codemod",
    "migration",
    "upgrade",
    "web-components"
  ],
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/codemod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/codemod"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "gyral-codemod": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.7",
    "@babel/types": "8.0.6",
    "diff": "9.0.0",
    "magic-string": "1.4.3"
  }
}
