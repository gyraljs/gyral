{
  "name": "@gyral/router",
  "version": "0.1.0",
  "description": "Gyral router: typed route tables, navigation as commands, History API baseline with Navigation API enhancement.",
  "license": "MIT",
  "author": "The Zoop Troop, Inc.",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@gyral/core": "workspace:*"
  }
}
