{
  "name": "@gyral/testing",
  "version": "0.3.4",
  "description": "Gyral test helpers: pure update stepping, command helpers, fake drivers, virtual time, SSR page mounting, server rendering in Vitest browser tests, schema arbitraries.",
  "license": "MIT",
  "author": "Mike Zupper",
  "homepage": "https://github.com/gyraljs/gyral/tree/main/packages/testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gyraljs/gyral.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/gyraljs/gyral/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./vitest": "./src/vitest.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vitest": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@gyral/core": "workspace:*",
    "@sinonjs/fake-timers": "15.4.0",
    "@standard-schema/spec": "1.1.0"
  },
  "peerDependencies": {
    "vitest": "^4.1.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@valibot/to-json-schema": "1.8.0",
    "vitest": "5.0.3"
  }
}
